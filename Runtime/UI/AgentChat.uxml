<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="AgentChat.uss" />
    <ui:VisualElement name="agentChat" class="agent-chat" picking-mode="Ignore">
        <ui:ScrollView name="messages" class="agent-chat__messages" horizontal-scroller-visibility="Hidden" />
        <ui:Label name="connectionStatus" class="agent-chat__status" />
        <ui:VisualElement name="composer" class="agent-chat__composer">
            <ui:Button name="connectionButton" class="agent-chat__button agent-chat__account" tooltip="Connect AI">
                <ui:VisualElement class="agent-chat__connection-dot" picking-mode="Ignore" />
            </ui:Button>
            <ui:TextField name="messageInput" class="agent-chat__input" multiline="true" tooltip="Message" />
            <ui:Button name="historyButton" class="agent-chat__button" tooltip="Hide conversation" />
            <ui:Button name="microphoneButton" class="agent-chat__button" tooltip="Voice is not available yet" />
            <ui:Button name="sendButton" class="agent-chat__button agent-chat__send" tooltip="Send" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
