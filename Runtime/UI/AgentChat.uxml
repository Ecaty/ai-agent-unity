<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="AgentChat.uss" />
    <ui:VisualElement name="agentChat" class="agent-chat">
        <ui:ScrollView name="messages" class="agent-chat__messages" />
        <ui:Label name="connectionStatus" class="agent-chat__status" />
        <ui:VisualElement class="agent-chat__composer">
            <ui:Button name="connectionButton" class="agent-chat__button" tooltip="Connect AI" />
            <ui:TextField name="messageInput" class="agent-chat__input" multiline="true" tooltip="Message" />
            <ui:Button name="microphoneButton" class="agent-chat__button" tooltip="Dictation unavailable" />
            <ui:Button name="sendButton" class="agent-chat__button" tooltip="Send" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
