.agent-chat {
    flex-grow: 1;
    max-height: 320px;
    padding: 10px;
    color: #eeeeef;
    background-color: rgba(24, 26, 31, 0.96);
    border-radius: 10px;
}
.agent-chat__messages { flex-grow: 1; }
.agent-chat__composer { flex-direction: row; align-items: center; margin-top: 6px; }
.agent-chat__input { flex-grow: 1; margin-right: 6px; }
.agent-chat__input .unity-text-input {
    color: #eeeeef;
    background-color: #252830;
    padding: 8px;
    border-width: 0;
    border-radius: 6px;
}
.agent-chat__button { margin-left: 4px; padding: 8px; border-width: 0; border-radius: 6px; }
.agent-chat__message { white-space: normal; margin-bottom: 8px; padding: 6px; }
.agent-chat__message--user { background-color: #303640; border-radius: 6px; }
